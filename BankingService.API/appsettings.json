{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SparkFinance;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ExchangeRates": {
    "BaseUrl": "https://api.frankfurter.dev/v2/",
    "ProviderName": "Frankfurter",
    "TimeoutSeconds": 15,
    "CacheMinutes": 30
  },
  "PaymentBanking": {
    "Enabled": true,
    "CashModes": [
      "Cash"
    ],
    "DraftModes": [
      "Cheque"
    ],
    "PostedModes": [
      "RTGS",
      "NEFT"
    ],
    "Routes": [
      {
        "Branches": [
          "Dubai"
        ],
        "Currency": "AED",
        "BankAccountName": "AmnikonDubaiBank",
        "TimeZoneId": "Arabian Standard Time"
      },
      {
        "Branches": [
          "Turbhe",
          "India",
          "Mumbai"
        ],
        "Currency": "INR",
        "BankAccountName": "AmnikonTurbheBank",
        "TimeZoneId": "India Standard Time"
      }
    ]
  }
}
