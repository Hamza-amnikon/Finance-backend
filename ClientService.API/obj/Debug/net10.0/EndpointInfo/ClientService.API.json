            "pattern": "^(Dubai|Turbhe)$",
            "type": "string"
          },
          "currency": {
            "pattern": "^[A-Za-z]{3}$",
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
