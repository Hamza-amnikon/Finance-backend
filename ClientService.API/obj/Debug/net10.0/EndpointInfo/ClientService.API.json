          "rowVersion": {
            "maxLength": 8,
            "minLength": 8,
            "type": "string",
            "format": "byte"
          }
        }
      },
      "CreateClientDto": {
        "required": [
          "name",
          "branch",
          "currency"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 200,
            "type": "string"
          },
          "companyName": {
            "maxLength": 200,
            "type": "string"
          },
          "email": {
            "maxLength": 254,
