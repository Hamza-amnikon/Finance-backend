<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>merit-azure-directory-service</UserSecretsId>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Azure.Identity" Version="1.21.0" />
        <PackageReference Include="Microsoft.Graph" Version="6.2.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.0" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="../PermissionService.API/Authentication/LoginSession*.cs" Link="Authentication/%(Filename)%(Extension)" />
        <Compile Include="../PermissionService.API/CallOtherApis/*LoginSessionClient.cs" Link="CallOtherApis/%(Filename)%(Extension)" />
        <Compile Include="../PermissionService.API/DTOs/LoginSessionResponse.cs" Link="DTOs/LoginSessionResponse.cs" />
    </ItemGroup>
</Project>
