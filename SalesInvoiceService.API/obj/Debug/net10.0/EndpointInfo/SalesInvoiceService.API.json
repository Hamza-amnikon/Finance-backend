{
  "openapi": "3.1.1",
  "info": {
    "title": "SalesInvoiceService.API | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7173"
    },
    {
      "url": "http://localhost:5242"
    }
  ],
  "paths": {
    "/api/currencies": {
      "get": {
        "tags": [
          "Currencies"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/currencies/{code}": {
      "get": {
        "tags": [
          "Currencies"
        ],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/payment-modes": {
      "get": {
        "tags": [
          "PaymentModes"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/sales-invoices/preview": {
      "post": {
        "tags": [
          "SalesInvoices"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSalesInvoiceDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSalesInvoiceDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSalesInvoiceDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/sales-invoices": {
      "post": {
        "tags": [
          "SalesInvoices"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSalesInvoiceDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSalesInvoiceDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSalesInvoiceDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/sales-invoices/{id}": {
      "get": {
        "tags": [
          "SalesInvoices"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateSalesInvoiceDto": {
        "required": [
          "currency",
          "branch",
          "items"
        ],
        "type": "object",
        "properties": {
          "clientId": {
            "type": "string",
            "format": "uuid"
          },
          "invoiceDate": {
            "type": "string",
            "format": "date"
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          },
          "servicePeriodStart": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "servicePeriodEnd": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "currency": {
            "pattern": "^[A-Za-z]{3}$",
            "type": "string"
          },
          "branch": {
            "maxLength": 20,
            "type": "string"
          },
          "paymentTerms": {
            "maxLength": 200,
            "type": "string"
          },
          "preferredPaymentMode": {
            "maxLength": 50,
            "type": "string"
          },
          "reference": {
            "maxLength": 200,
            "type": "string"
          },
          "billingAddress": {
            "maxLength": 1000,
            "type": [
              "null",
              "string"
            ]
          },
          "notes": {
            "maxLength": 2000,
            "type": "string"
          },
          "additionalTerms": {
            "maxLength": 2000,
            "type": "string"
          },
          "items": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SalesInvoiceItemRequestDto"
            }
          }
        }
      },
      "SalesInvoiceItemRequestDto": {
        "required": [
          "serviceName"
        ],
        "type": "object",
        "properties": {
          "serviceName": {
            "maxLength": 200,
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "type": "string"
          },
          "unit": {
            "$ref": "#/components/schemas/ServiceUnit"
          },
          "quantity": {
            "maximum": 99999999999999.9999,
            "minimum": 0.0001,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "unitPrice": {
            "maximum": 99999999999999.9999,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "discountAmount": {
            "maximum": 99999999999999.9999,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "taxRate": {
            "maximum": 100,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "ServiceUnit": {
        "type": "integer"
      }
    }
  },
  "tags": [
    {
      "name": "Currencies"
    },
    {
      "name": "PaymentModes"
    },
    {
      "name": "SalesInvoices"
    }
  ]
}